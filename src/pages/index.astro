---
import App from "../components/App";
// Pixel CJK face for camera OSD text (VT323 has no Chinese glyphs). OFL-1.1, unicode-range subsets.
import "@fontsource/fusion-pixel-12px-monospaced-tc";
import "../styles/global.css";

// Social previews need absolute URLs: the deployed production domain on Vercel, else wherever this was built / served.
const env = (globalThis as { process?: { env: Record<string, string | undefined> } }).process?.env ?? {};
const vercelHost = env.VERCEL_PROJECT_PRODUCTION_URL ?? import.meta.env.VERCEL_PROJECT_PRODUCTION_URL;
const origin = Astro.site?.origin ?? (vercelHost ? `https://${vercelHost}` : Astro.url.origin);
const title = "HK CCTV · 香港閉路電視";
const description =
  "Channel-surf Hong Kong's open data like a security control room: 1,000+ traffic cameras, Observatory weather, radar and satellite, live news and Hong Kong YouTube — on a video wall with patrol sequences and an optional colour CRT monitor.";
const image = `${origin}/og.jpg`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0c0f" />
    <meta name="description" content={description} />
    <link rel="canonical" href={`${origin}/`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HK CCTV" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${origin}/`} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="HK CCTV video wall in CRT mode: traffic cameras, weather radar, a speed-map panel, the satellite image and a news ticker" />
    <meta property="og:locale" content="en_HK" />
    <meta property="og:locale:alternate" content="zh_HK" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="HK CCTV" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <!-- Offline support (public/sw.js) runs in production builds only: dev never gets stale cached bundles. -->
    <meta name="service-worker" content={import.meta.env.PROD ? "on" : "off"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://tdcctv.data.one.gov.hk" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&family=Noto+Sans+TC:wght@400;500;600&family=VT323&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <App client:only="react" />
    <noscript>HK CCTV needs JavaScript to tune into camera feeds.</noscript>
  </body>
</html>
